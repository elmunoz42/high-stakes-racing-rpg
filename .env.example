# Copy to .env and fill in. .env is gitignored. Never commit a real key.
# A ChatGPT subscription does not include API access: create an API key with
# billing at platform.openai.com.
# LLM_PROVIDER: openai (real characters) or mock (scripted, free, used by tests)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OpenAI API model id for GPT-6 Luna (checked 2026-11-09 on developers.openai.com).
NPC_MODEL=gpt-6-luna
# Reasoning effort for characters: none | low | medium | high. Low keeps replies fast.
NPC_REASONING_EFFORT=low
API_PORT=8787
